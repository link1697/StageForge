# 大模型 API 配置（支持 Google Gemini / DeepSeek / OpenAI / Ollama 等）

# 示例 1: Google Gemini (推荐，使用免费配额大的轻量模型)
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL_NAME=gemini-3.5-flash-lite

# 示例 2: DeepSeek
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL_NAME=deepseek-chat

# 示例 3: 国内 SiliconFlow (赠送数千万 Token)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_MODEL_NAME=deepseek-ai/DeepSeek-V3

# 示例 4: 本地 Ollama
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL_NAME=qwen2.5:7b
